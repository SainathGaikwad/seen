# What `gcloud run deploy --source .` uploads to Cloud Build. Without this file gcloud copies
# .gitignore, which would drop data/seen.duckdb and the derived files the app needs.
.git
.gitignore
.venv
venv
__pycache__
**/__pycache__
*.pyc
.pytest_cache
.env
.env.*
!.env.example
data/raw/
data/cache/
data/derived_fixture_backup/
docs/*.mp4
docs/*.pdf
docs/*.zip
tests/
scratch/
*.zip
*.log
.DS_Store
Thumbs.db
