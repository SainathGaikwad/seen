# Copy to .env (or export in your shell). Nothing here is required: without a key,
# SEEN runs in TEMPLATE mode (fact-locked deterministic text, no translation).

# One of: gemini | nebius | anthropic | openai | none
LLM_PROVIDER=none
GEMINI_API_KEY=
# NVIDIA Nemotron open models served by Nebius Token Factory (OpenAI-compatible): https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model override (any provider)
LLM_MODEL=

# Wikimedia asks for a descriptive User-Agent with contact info
SEEN_USER_AGENT="SEEN-hackathon/0.1 (contact: you@example.com)"

# Optional: YouTube Data API key for the ICC channel signal (not used in the MVP pipeline)
YOUTUBE_API_KEY=
